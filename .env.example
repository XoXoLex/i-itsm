# Copy to .env and fill in what you need. Everything is optional.
PORT=3000
DB_PATH=data/itsm.db
# Seconds between background SLA checks
SLA_CHECK_SECONDS=30
# Fixed secret keeps people logged in across restarts (otherwise one is generated and stored in the DB)
# JWT_SECRET=change-me
# Turn on AI categorization (free key from Google AI Studio). Falls back to keywords if unset or failing.
# GEMINI_API_KEY=
# decisions = Gemini Decisions API with gemini-decision-1 (default; built for picking from a fixed list)
# generate  = a chat model through generateContent (default model gemini-4-hydrogen)
# GEMINI_MODE=decisions
# GEMINI_DECISION_MODEL=gemini-decision-1
# GEMINI_MODEL=gemini-4-hydrogen
