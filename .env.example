# Copy to .env and fill in what you need. Everything is optional.
PORT=3000
DB_PATH=data/itsm.db
# Seconds between background SLA checks
SLA_CHECK_SECONDS=30
# Fixed secret keeps people logged in across restarts (otherwise one is generated and stored in the DB)
# JWT_SECRET=change-me
# Turn on AI categorization (free key from Google AI Studio). Falls back to keywords if unset or failing.
# GEMINI_API_KEY=
# decisions = Gemini Decisions API with gemini-decision-1 (default; built for picking from a fixed list)
# generate  = a chat model through generateContent (default model gemini-3.8-flash)
# GEMINI_MODE=decisions
# GEMINI_DECISION_MODEL=gemini-decision-1
# GEMINI_MODEL=gemini-3.8-flash
# Real email through Resend (resend.com). Without both, email is simulated and only written to the Email log.
# RESEND_API_KEY=
# EMAIL_FROM=Service Desk <desk@your-verified-domain.com>
# Only needed if the frontend is served from a different origin than the API (comma separated)
# CORS_ORIGIN=https://example.com
# Set to 1 when running behind a reverse proxy, so login lockout sees the real client address
# TRUST_PROXY=1
